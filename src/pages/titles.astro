---
import Base from '../layouts/Base.astro';
import data from '../data/titles.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { roots, counts } = data;

const hegemonies = roots.filter((r) => r.tier === 'hegemony');
const empires = [
  ...hegemonies.flatMap((h) => (h.children ?? []).filter((c) => c.tier === 'empire')),
  ...roots.filter((r) => r.tier === 'empire'),
];
const looseTitles = roots.filter((r) => r.tier !== 'hegemony' && r.tier !== 'empire');

function countTier(n: any, tier: string): number {
  let c = n.tier === tier ? 1 : 0;
  for (const ch of n.children ?? []) c += countTier(ch, tier);
  return c;
}
const isTitular = (n: any) => !(n.children ?? []).length;

// Titles carrying regnal-name pools (landed_titles holding_/posthumous_regnal_*_names).
const regnalTitles: any[] = [];
(function walk(nodes: any[]) {
  for (const n of nodes) {
    if (n.regnalNames) regnalTitles.push(n);
    walk(n.children ?? []);
  }
})(roots as any[]);
const REGNAL_LABELS: [string, string][] = [
  ['holdingMale', 'Male holders, on gaining the title'],
  ['holdingFemale', 'Female holders, on gaining the title'],
  ['posthumousMale', 'Male holders, on losing the title'],
  ['posthumousFemale', 'Female holders, on losing the title'],
];
---
<Base
  title="Titles"
  active="titles"
  lede="The complete de jure hierarchy from landed_titles — every empire's kingdoms, duchies, counties, and baronies, with special and titular titles flagged."
  stats={[
    { value: counts.empire, label: 'empires' },
    { value: counts.kingdom, label: 'kingdoms' },
    { value: counts.duchy, label: 'duchies' },
    { value: counts.county, label: 'counties' },
    { value: counts.barony, label: 'baronies' },
  ]}
>
  {hegemonies.length > 0 && (
    <section>
      <h2 class="group-h">Hegemonies <span class="count">{hegemonies.length}</span></h2>
      <div class="tgrid">
        {hegemonies.map((h) => (
          <a class="tcard" href={`${base}/titles/${h.id}`}>
            <span class="sw" style={`--c:${h.color ?? 'var(--line)'}`} />
            <span class="tname">{h.name}</span>
            <span class="tsub">{(h.children ?? []).filter((c: any) => c.tier === 'empire').length} empires</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section>
    <h2 class="group-h">Empires <span class="count">{empires.length}</span></h2>
    <div class="filterbar">
      <input type="search" id="q" placeholder="Filter empires…" autocomplete="off" />
      <span class="hint" id="count"></span>
    </div>
    <div class="tgrid" id="empires">
      {empires.map((e) => (
        <a class="tcard" href={`${base}/titles/${e.id}`} data-name={e.name.toLowerCase()}>
          <span class="sw" style={`--c:${e.color ?? 'var(--line)'}`} />
          <span class="tname">{e.name}</span>
          <span class="tsub">
            {isTitular(e) ? 'titular' : `${countTier(e, 'kingdom')} kingdoms · ${countTier(e, 'county')} counties`}
          </span>
        </a>
      ))}
    </div>
  </section>

  {looseTitles.length > 0 && (
    <section>
      <h2 class="group-h">Special & independent titles <span class="count">{looseTitles.length}</span></h2>
      <p class="lede">Mercenary companies, holy orders, and other titles outside the de jure pyramid.</p>
      <div class="chips">
        {looseTitles.map((t) => (
          <span class="chip" title={(t.flags ?? []).join(', ') || t.tier}>{t.name}</span>
        ))}
      </div>
    </section>
  )}

  {regnalTitles.length > 0 && (
    <section>
      <h2 class="group-h">Regnal names <span class="count">{regnalTitles.length}</span></h2>
      <p class="lede">Titles with their own name pools: a holder is assigned one of these names when they gain the title, or (posthumous) when they lose it.</p>
      {regnalTitles.map((t) => (
        <div class="regnal" id={`regnal-${t.id}`}>
          <h3><span class="sw sw--i" style={`--c:${t.color ?? 'var(--line)'}`} /> {t.name} <span class="subtle">{t.tier}</span></h3>
          {REGNAL_LABELS.filter(([k]) => t.regnalNames[k]).map(([k, label]) => (
            <p class="rn"><b>{label}</b> <span class="subtle">({t.regnalNames[k].length})</span> — {t.regnalNames[k].join(' · ')}</p>
          ))}
        </div>
      ))}
    </section>
  )}

  <script>
    const q = document.getElementById('q') as HTMLInputElement;
    const count = document.getElementById('count')!;
    const cards = [...document.querySelectorAll<HTMLElement>('#empires .tcard')];
    q.addEventListener('input', () => {
      const needle = q.value.trim().toLowerCase();
      let shown = 0;
      for (const c of cards) {
        const ok = !needle || (c.dataset.name ?? '').includes(needle);
        c.hidden = !ok;
        if (ok) shown++;
      }
      count.textContent = `${shown} of ${cards.length}`;
    });
  </script>

  <style>
    .tgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 0.6rem; }
    .tcard {
      display: grid; grid-template-columns: 14px 1fr; grid-template-rows: auto auto;
      column-gap: 0.55rem; align-items: center;
      background: var(--panel); border: 1px solid var(--line-soft); border-radius: var(--r);
      padding: 0.55rem 0.7rem; border-bottom: 1px solid var(--line-soft); color: var(--vellum);
    }
    .tcard:hover { border-color: var(--brass); }
    .sw { grid-row: 1 / 3; width: 14px; height: 28px; border-radius: 3px; background: var(--c); }
    .tname { font-family: var(--font-display); font-size: 0.95rem; }
    .tsub { color: var(--faint); font-size: 0.72rem; grid-column: 2; }
    .regnal { background: var(--panel); border: 1px solid var(--line-soft); border-radius: var(--r); padding: 0.55rem 0.8rem; margin-bottom: 0.6rem; }
    .regnal h3 { font-family: var(--font-display); font-size: 0.95rem; margin: 0 0 0.3rem; }
    .sw--i { display: inline-block; width: 9px; height: 14px; vertical-align: -2px; }
    .rn { font-size: 0.85rem; margin: 0.25rem 0; }
    .subtle { color: var(--faint); font-size: 0.75rem; }
  </style>
</Base>
