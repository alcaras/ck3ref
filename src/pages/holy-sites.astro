---
import Base from '../layouts/Base.astro';
import sites from '../data/holy_sites.json';
import faithData from '../data/faiths.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// reverse map: holy site -> faiths that list it (eminent or regular)
type User = { id: string; name: string | null; color: string | null; eminent: boolean };
const usedBy = new Map<string, User[]>();
for (const f of faithData.faiths as any[]) {
  for (const [list, eminent] of [[f.eminentHolySites, true], [f.holySites, false]] as const) {
    for (const h of list) {
      if (!usedBy.has(h.key)) usedBy.set(h.key, []);
      usedBy.get(h.key)!.push({ id: f.id, name: f.name, color: f.color, eminent });
    }
  }
}
const usedCount = [...usedBy.keys()].filter((k) => sites.some((s) => s.id === k)).length;

const religionName = new Map(faithData.religions.map((r) => [r.id, r.name]));
const religionOf = new Map(faithData.faiths.map((f) => [f.id, f.religion]));
const religions = [...new Set(faithData.faiths.map((f) => f.religion))].sort((a, b) =>
  (religionName.get(a) ?? a).localeCompare(religionName.get(b) ?? b)
);
---
<Base
  title="Holy Sites"
  active="holy-sites"
  lede="Every holy site defined in the game, where it sits on the map, and its bonuses: for the county holder of the same faith, for every character of a faith that holds it as an Eminent site, and the extra that scales with the rarity of its holy relics. Dynamic sites have no fixed location."
  stats={[
    { value: sites.length, label: 'holy sites' },
    { value: usedCount, label: 'used by a faith at start' },
    { value: faithData.faiths.length, label: 'faiths' },
  ]}
>
  <div class="filterbar">
    <input type="search" id="q" placeholder="Filter by site, county, faith…" autocomplete="off" />
    <select id="frel">
      <option value="">every religion</option>
      {religions.map((r) => <option value={r}>{religionName.get(r)}</option>)}
    </select>
    <label class="hint"><input type="checkbox" id="fused" /> used at start only</label>
    <span class="hint" id="count"></span>
  </div>

  <div class="tbl-scroll">
    <table class="ntbl">
      <thead>
        <tr>
          <th>Holy site</th>
          <th>County</th>
          <th>County holder</th>
          <th title="Applies to every character of the faith, only when the site is one of the faith's Eminent holy sites">Faith-wide (Eminent)</th>
          <th>Faiths</th>
        </tr>
      </thead>
      <tbody>
        {sites.map((s) => {
          const users = usedBy.get(s.id) ?? [];
          return (
            <tr
              id={s.id}
              data-name={`${s.name} ${s.countyName ?? ''} ${s.baronyName ?? ''} ${users.map((u) => u.name).join(' ')}`.toLowerCase()}
              data-religions={users.map((u) => religionOf.get(u.id)).join(' ')}
              data-used={users.length > 0 ? '1' : ''}
            >
              <td class="name">
                <span class="u-name">{s.name}</span>
                {s.dlc && <span class="badge-dlc">{s.dlc}</span>}
              </td>
              <td>
                {s.dynamic ? <span class="subtle" title="is_dynamic: a general site type without a fixed location">dynamic</span> : (s.countyName ?? <span class="subtle">—</span>)}
                {s.baronyName && <span class="u-sub"><br />{s.baronyName}</span>}
              </td>
              <td class="fx">
                {s.holderModifiers.map((m: string) => <div>{m}</div>)}
                {s.countyModifiersScaled.map((sc: any) => (
                  <div class="scaled" title={sc.scaleName ?? String(sc.scale)}>
                    <span class="subtle">county, per relic rarity:</span>
                    {sc.lines.map((m: string) => <div>{m}</div>)}
                  </div>
                ))}
                {s.effects && <div>{s.effects}</div>}
                {s.parameters.map((p: any) => <div class="subtle">{p.text ?? p.key.replace(/_/g, ' ')}</div>)}
                {s.holderModifiers.length + s.parameters.length + s.countyModifiersScaled.length === 0 && !s.effects && <span class="subtle">—</span>}
              </td>
              <td class="fx">
                {s.eminentModifiers.map((m: string) => <div>{m}</div>)}
                {s.eminentModifiersScaled.map((sc: any) => (
                  <div class="scaled" title={sc.scaleName ?? String(sc.scale)}>
                    <span class="subtle">per relic rarity:</span>
                    {sc.lines.map((m: string) => <div>{m}</div>)}
                  </div>
                ))}
                {s.eminentModifiers.length + s.eminentModifiersScaled.length === 0 && <span class="subtle">—</span>}
              </td>
              <td>
                <span class="chips">
                  {users.map((u) => (
                    <a class:list={['chip', { 'chip--eminent': u.eminent }]} href={`${base}/faiths#${u.id}`} title={u.eminent ? 'Eminent holy site of this faith' : undefined}>
                      <span class="dot" style={`--c:${u.color ?? 'var(--faint)'}`} />
                      {u.name}
                    </a>
                  ))}
                  {users.length === 0 && <span class="subtle" title="No faith lists this site at game start — reachable via reformation or events">unused at start</span>}
                </span>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <p class="prov">
    "Per relic rarity" bonuses multiply by the site's
    <code>holy_site_total_artifact_rarity</code>: the sum of the rarities of its
    holy relics (1 Common, 2 Masterwork, 3 Famed, 4 Illustrious), per the game's
    own schema doc. Eminent chips mark the faiths whose Eminent sites include it.
  </p>

  <script>
    const q = document.getElementById('q') as HTMLInputElement;
    const frel = document.getElementById('frel') as HTMLSelectElement;
    const fused = document.getElementById('fused') as HTMLInputElement;
    const count = document.getElementById('count')!;
    const rows = [...document.querySelectorAll<HTMLTableRowElement>('tbody tr')];

    function apply() {
      const needle = q.value.trim().toLowerCase();
      const rel = frel.value;
      let shown = 0;
      for (const r of rows) {
        const ok =
          (!needle || (r.dataset.name ?? '').includes(needle)) &&
          (!rel || (r.dataset.religions ?? '').split(' ').includes(rel)) &&
          (!fused.checked || r.dataset.used === '1');
        r.hidden = !ok;
        if (ok) shown++;
      }
      count.textContent = `${shown} of ${rows.length}`;
    }
    for (const el of [q, frel, fused]) el.addEventListener('input', apply);
    apply();
  </script>

  <style>
    .fx { font-size: 0.8rem; max-width: 26rem; }
    .chips { max-width: 26rem; }
    .fx .scaled { margin-top: 0.25rem; padding-left: 0.5rem; border-left: 2px solid var(--line); }
    .chip--eminent { border-color: color-mix(in oklab, var(--brass) 60%, var(--line)); font-weight: 600; }
    .prov { color: var(--faint); font-size: 0.78rem; max-width: 70ch; margin-top: 1.5rem; }
    .prov code { font-family: var(--font-mono); }
    tr:target { background: color-mix(in oklab, var(--brass) 12%, transparent); }
    .filterbar label.hint { display: inline-flex; align-items: center; gap: 0.3rem; margin-left: 0; }
  </style>
</Base>
