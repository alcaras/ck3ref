---
import Base from '../layouts/Base.astro';
import { SECTIONS, TABS } from '../data/tabs';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base
  title="Crusader Kings III Reference"
  docTitle="CK3 Reference"
  lede={`Every number on this site is read from the game's own data files and regenerated each patch — ${TABS.length} reference pages and tools, from traits and men-at-arms to the de jure map and the 867/1066 world.`}
>
  <div class="sec-grid">
    {SECTIONS.map((section) => (
      <div class="sec-card">
        <h2>{section}</h2>
        <ul>
          {TABS.filter((t) => t.section === section).map((t) => (
            <li class:list={[{ soon: t.status !== 'built' }]}>
              {t.status === 'built' ? <a href={`${base}/${t.slug}`}>{t.label}</a> : t.label}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</Base>
