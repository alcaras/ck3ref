---
import Base from '../layouts/Base.astro';
import patch from '../../data/patch.json';
import fs from 'node:fs';
import path from 'node:path';

// The changelog is generated by scripts/changelog.py at patch time; parse its
// markdown into sections so the site shows what changed without a MD renderer.
const file = path.join(process.cwd(), 'CHANGELOG.md');
const raw = fs.existsSync(file) ? fs.readFileSync(file, 'utf8') : '';
const sections: { version: string; lines: string[] }[] = [];
for (const block of raw.split(/^## /m).slice(1)) {
  const [head, ...body] = block.split('\n');
  sections.push({
    version: head.trim(),
    lines: body.map((l) => l.trim()).filter((l) => l.startsWith('- ')).map((l) => l.slice(2)),
  });
}
const glyph = (l: string) =>
  l.startsWith('➕') ? 'add' : l.startsWith('➖') ? 'rem' : l.startsWith('🌱') ? 'new' : 'chg';
const strip = (l: string) => l.replace(/^[➕➖✏️🌱]\s*/, '');
---
<Base
  title="Patch Notes"
  active="patch-notes"
  lede="What changed in the game's data between builds of this site. Generated by diffing every dataset against the previous patch snapshot — additions, removals, and per-field changes."
  stats={[
    { value: patch.version, label: 'current build' },
    { value: sections.length, label: 'tracked builds' },
    { value: sections.reduce((n, s) => n + s.lines.length, 0), label: 'recorded changes' },
  ]}
>
  {sections.length === 0 && (
    <p class="empty">
      No changelog yet — it fills in the next time the game patches and
      <code>make patch</code> runs against fresh data.
    </p>
  )}

  {sections.map((s) => (
    <section>
      <h2 class="group-h" id={s.version}>{s.version} <span class="count">{s.lines.length} changes</span></h2>
      <ul class="changes">
        {s.lines.slice(0, 400).map((l) => (
          <li class:list={['chg-' + glyph(l)]}>{strip(l)}</li>
        ))}
        {s.lines.length > 400 && <li class="subtle">… and {s.lines.length - 400} more</li>}
      </ul>
    </section>
  ))}

  <p class="prov">
    Sourced from <code>CHANGELOG.md</code>, which
    <code>scripts/changelog.py</code> writes by comparing every generated
    dataset against the last patch snapshot. Anything the game changed that
    this site renders shows up here automatically.
  </p>

  <style>
    .changes { list-style: none; padding: 0; margin: 0; font-size: 0.85rem; }
    .changes li { padding: 0.12rem 0 0.12rem 1.2rem; position: relative; color: var(--vellum); }
    .changes li::before { position: absolute; left: 0; font-family: var(--font-mono); }
    .chg-add::before { content: '+'; color: var(--good); }
    .chg-rem::before { content: '−'; color: var(--bad); }
    .chg-chg::before { content: '~'; color: var(--brass); }
    .chg-new::before { content: '✦'; color: var(--rubric); }
    .empty, .prov { color: var(--faint); font-size: 0.85rem; max-width: 64ch; }
    .prov { margin-top: 2rem; font-size: 0.78rem; }
    code { font-family: var(--font-mono); }
  </style>
</Base>
