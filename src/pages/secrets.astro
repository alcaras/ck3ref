---
import Base from '../layouts/Base.astro';
import data from '../data/secrets.json';

const { secrets, hooks, concepts } = data as any;
const categories = [...new Set(secrets.map((s: any) => s.category))];
const catLabel = (c: string) => String(c ?? 'other').replace(/_/g, ' ');
---
<Base
  title="Secrets & Hooks"
  active="secrets"
  lede="What can be held over someone. Whether a secret is merely shunned or outright criminal depends on the faith judging it — those conditions are the game's own trigger names, shown as written."
  stats={[
    { value: secrets.length, label: 'secret types' },
    { value: hooks.length, label: 'hook types' },
    { value: hooks.filter((h: any) => h.strong).length, label: 'strong hooks' },
  ]}
>
  {categories.map((cat) => (
    <section>
      <h2 class="group-h" id={`secret-${catLabel(cat as string).replace(/ /g, '-')}`}>
        {catLabel(cat as string)} secrets
        <span class="count">{secrets.filter((s: any) => s.category === cat).length}</span>
      </h2>
      <div class="tbl-scroll">
        <table class="ntbl">
          <thead><tr><th>Secret</th><th>Shunned when</th><th>Criminal when</th><th>DLC</th></tr></thead>
          <tbody>
            {secrets.filter((s: any) => s.category === cat).map((s: any) => (
              <tr id={s.id}>
                <td class="name">
                  <span class="u-name">{s.name}</span>
                  {s.desc && <div class="u-sub">{s.desc}</div>}
                </td>
                <td>
                  <span class="chips">
                    {s.shunnedWhen.length
                      ? s.shunnedWhen.map((c: string) => <span class="chip">{c}</span>)
                      : <span class="subtle">never</span>}
                  </span>
                </td>
                <td>
                  <span class="chips">
                    {s.criminalWhen.length
                      ? s.criminalWhen.map((c: string) => <span class="chip chip--counter">{c}</span>)
                      : <span class="subtle">never</span>}
                  </span>
                </td>
                <td>{s.dlc ? <span class="badge-dlc">{s.dlc}</span> : <span class="subtle">—</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))}

  <section>
    <h2 class="group-h" id="hooks">Hooks <span class="count">{hooks.length}</span></h2>
    {(concepts?.strong_hook || concepts?.weak_hook) && (
      <div class="concept-notes">
        {['strong_hook', 'weak_hook'].filter((k) => concepts?.[k]).map((k) => (
          <div class="cnote">
            <b>{concepts[k].name}</b>
            <p>{concepts[k].desc.split('\n').filter(Boolean).slice(0, 2).join(' ')}</p>
          </div>
        ))}
        <p class="src">— the game's own glossary entries, verbatim.</p>
      </div>
    )}
    <div class="tbl-scroll">
      <table class="ntbl">
        <thead><tr><th>Hook</th><th>Strength</th><th>Duration</th><th>Source</th><th>DLC</th></tr></thead>
        <tbody>
          {hooks.map((h: any) => (
            <tr id={h.id}>
              <td class="name">{h.name}</td>
              <td>
                <span class:list={['chip', h.strong ? 'chip--counter' : '']}>
                  {h.strong ? 'strong' : 'weak'}
                </span>
              </td>
              <td class="subtle">
                {h.perpetual ? 'perpetual' : h.expiryDays ? `${h.expiryDays} days` : '—'}
              </td>
              <td class="subtle">{h.requiresSecret ? 'requires a secret' : '—'}</td>
              <td>{h.dlc ? <span class="badge-dlc">{h.dlc}</span> : <span class="subtle">—</span>}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <style>
    .ntbl td.name { white-space: normal; max-width: 20rem; }
    .note { color: var(--dim); max-width: 66ch; margin: 0 0 0.6rem; }
    .concept-notes { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 0.8rem; margin-bottom: 0.8rem; }
    .cnote { background: var(--panel); border: 1px solid var(--line-soft);
      border-radius: var(--r); padding: 0.6rem 0.8rem; }
    .cnote b { font-family: var(--font-display); }
    .cnote p { color: var(--dim); font-size: 0.82rem; margin: 0.25rem 0 0; }
    .src { grid-column: 1 / -1; color: var(--faint); font-size: 0.75rem; margin: 0; }
  </style>
</Base>
