---
import Base from '../layouts/Base.astro';
import legacies from '../data/legacies.json';
import costs from '../data/legacy-costs.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Order matters: renown is spent step by step, so a build is a sequence.
const tracks = (legacies as any[]).map((t) => ({
  id: t.id,
  name: t.name,
  desc: t.desc,
  dlc: t.dlc,
  gate: t.gate,
  perks: t.perks.map((p: any) => ({ id: p.id, name: p.name, effects: p.effects })),
}));
// Perk cost is GLOBAL, not per track: the Nth perk you buy anywhere costs
// base + (N-1) x perStep (defines PERK_COST_BASE / PERK_COST_MULTIPLIER).
const COST = costs as { base: number; perStep: number; formula: string };
const nthCost = (n: number) => COST.base + n * COST.perStep; // n = already owned
---
<Base
  title="Legacy Builder"
  active="legacy-builder"
  lede={`Plan a dynasty's legacy path in the order you'll actually buy it. Each perk costs ${COST.base} renown plus ${COST.perStep} for every perk you already own — across all tracks — so the later a pick comes, the more it costs.`}
  stats={[
    { value: tracks.length, label: 'tracks' },
    { value: tracks.reduce((n, t) => n + t.perks.length, 0), label: 'perks' },
    { value: `${COST.base} + ${COST.perStep}`, label: 'renown per perk, per perk owned' },
  ]}
>
  <div class="filterbar">
    <button id="share" class="btn-primary">Copy share link</button>
    <button id="clear">Clear</button>
    <span class="hint">
      Total <b id="total">0</b> renown · <b id="steps">0</b> steps
    </span>
  </div>

  <div class="cols">
    <section class="picker">
      <h2 class="group-h">Tracks</h2>
      <p class="note">Click a perk to append the next unbought step of its track to your plan.</p>
      <div class="tracks">
        {tracks.map((t) => (
          <div class="track" data-track={t.id}>
            <div class="tk-banner" style={`--art:url(${base}/img/legacy-banners/${t.id}.webp)`}>
              <img class="tk-icon" src={`${base}/img/legacies/${t.id}.webp`} alt="" width="30" height="30" loading="lazy" onerror="this.hidden=true" />
              <b>{t.name}</b>
              {t.dlc && <span class="badge-dlc">{t.dlc}</span>}
            </div>
            {t.gate && <div class="gate subtle">{t.gate}</div>}
            <div class="steps">
              {t.perks.map((p: any, i: number) => (
                <button class="step" data-track={t.id} data-step={i}
                  title={p.effects.join('\n') || p.name}>
                  <span class="n">{i + 1}</span>{p.name}
                </button>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <aside class="plan">
      <h2 class="group-h">Your build</h2>
      <ol id="planlist" class="planlist"></ol>
      <p class="empty" id="empty">Nothing picked yet — the order you buy in is the order shown here.</p>
      <div class="summary" id="summary"></div>
    </aside>
  </div>

  <p class="prov">
    Cost model read from <code>defines</code>:
    <code>PERK_COST_BASE {COST.base}</code> +
    <code>PERK_COST_MULTIPLIER {COST.perStep}</code> × perks already unlocked,
    counted across every track — so a build's total depends on how many perks
    it has, not which tracks they came from. Renown discounts (house unity,
    legacy-cost modifiers, the Kurultai) are not applied.
  </p>

  <script is:inline define:vars={{ tracks, COST, base }}>
    const byId = new Map(tracks.map((t) => [t.id, t]));
    const order = tracks.map((t) => t.id); // stable index for share links
    let plan = []; // [{track, step}] in purchase order

    const $ = (id) => document.getElementById(id);
    const esc = (s) => (s ?? '').replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));

    function boughtSteps(trackId) {
      return plan.filter((p) => p.track === trackId).length;
    }

    function render() {
      const list = $('planlist');
      list.innerHTML = plan.map((p, i) => {
        const t = byId.get(p.track);
        const perk = t.perks[p.step];
        return `<li data-i="${i}">
          <img src="${base}/img/legacies/${t.id}.webp" alt="" width="26" height="26" onerror="this.hidden=true">
          <span class="pl-n"><b>${esc(perk.name)}</b>
            <span class="subtle">${esc(t.name)} ${p.step + 1}</span></span>
          <span class="pl-c">${(COST.base + i * COST.perStep).toLocaleString()}</span>
          <button class="rm" data-i="${i}" title="remove this and later steps of the track">×</button>
        </li>`;
      }).join('');
      $('empty').hidden = plan.length > 0;

      // the k-th perk bought (0-indexed k) costs base + k*perStep
      const total = plan.reduce((n, _p, k) => n + COST.base + k * COST.perStep, 0);
      $('total').textContent = total.toLocaleString();
      $('steps').textContent = plan.length;

      // completed-track summary of every effect the build grants
      const effects = [];
      for (const p of plan) {
        const t = byId.get(p.track);
        for (const e of t.perks[p.step].effects) effects.push(e);
      }
      $('summary').innerHTML = effects.length
        ? `<h3>What the build gives you</h3><ul>${effects.map((e) => `<li>${esc(e)}</li>`).join('')}</ul>`
        : '';

      // mark picked steps and show which step comes next per track
      for (const btn of document.querySelectorAll('.step')) {
        const n = boughtSteps(btn.dataset.track);
        const step = +btn.dataset.step;
        btn.classList.toggle('is-picked', step < n);
        btn.classList.toggle('is-next', step === n);
      }
      updateURL();
    }

    function add(trackId, upToStep) {
      // buying step N implies owning 1..N of that track, in order
      let have = boughtSteps(trackId);
      while (have <= upToStep) {
        plan.push({ track: trackId, step: have });
        have++;
      }
      render();
    }

    function removeFrom(i) {
      const { track, step } = plan[i];
      // drop this step and every later step of the same track
      plan = plan.filter((p) => !(p.track === track && p.step >= step));
      render();
    }

    function updateURL() {
      const enc = plan.map((p) => `${order.indexOf(p.track)}.${p.step}`).join('_');
      const url = new URL(location.href);
      if (enc) url.searchParams.set('b', enc);
      else url.searchParams.delete('b');
      history.replaceState(null, '', url);
    }

    function loadFromURL() {
      const raw = new URLSearchParams(location.search).get('b');
      if (!raw) return;
      plan = raw.split('_').map((s) => {
        const [ti, st] = s.split('.').map(Number);
        const track = order[ti];
        return track && st >= 0 && st < 5 ? { track, step: st } : null;
      }).filter(Boolean);
    }

    document.addEventListener('click', (ev) => {
      const step = ev.target.closest('.step');
      if (step) { add(step.dataset.track, +step.dataset.step); return; }
      const rm = ev.target.closest('.rm');
      if (rm) { removeFrom(+rm.dataset.i); return; }
    });
    $('clear').addEventListener('click', () => { plan = []; render(); });
    $('share').addEventListener('click', async () => {
      updateURL();
      try { await navigator.clipboard.writeText(location.href); } catch {}
      const b = $('share'), t = b.textContent;
      b.textContent = 'Copied!';
      setTimeout(() => (b.textContent = t), 1500);
    });

    loadFromURL();
    render();
  </script>

  <style>
    .cols { display: grid; grid-template-columns: 1fr 22rem; gap: 1.25rem; align-items: start; }
    @media (max-width: 950px) { .cols { grid-template-columns: 1fr; } }
    .tracks { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 0.6rem; }
    .track { background: var(--panel); border: 1px solid var(--line-soft); border-radius: var(--r); padding: 0.55rem 0.7rem; }
    .track { padding: 0; overflow: hidden; }
    .tk-banner {
      display: flex; gap: 0.45rem; align-items: center;
      padding: 0.5rem 0.7rem; margin-bottom: 0.3rem;
      background-image: linear-gradient(to right,
        color-mix(in oklab, var(--ink) 88%, transparent),
        color-mix(in oklab, var(--ink) 55%, transparent)), var(--art);
      background-size: cover; background-position: center;
      border-bottom: 1px solid var(--line);
    }
    .tk-banner b { font-family: var(--font-display); font-size: 0.98rem;
      text-shadow: 0 1px 3px rgba(0,0,0,0.85); }
    .tk-icon { filter: drop-shadow(0 1px 2px rgba(0,0,0,0.8)); }
    .gate, .steps { padding: 0 0.7rem; }
    .steps { padding-bottom: 0.5rem; }
    .gate { font-size: 0.72rem; margin-bottom: 0.3rem; }
    .plan-banner { height: 34px; border-radius: 3px; background-size: cover;
      background-position: center; margin: 0.35rem 0 0.2rem;
      border: 1px solid var(--line-soft); }
    .steps { display: flex; flex-direction: column; gap: 0.15rem; }
    .step {
      display: flex; gap: 0.45rem; align-items: baseline; text-align: left;
      background: none; border: 1px solid transparent; border-radius: 3px;
      color: var(--dim); font: 0.8rem var(--font-ui); cursor: pointer; padding: 0.15rem 0.35rem;
    }
    .step:hover { border-color: var(--brass); color: var(--vellum); }
    .step .n { font-family: var(--font-mono); font-size: 0.68rem; color: var(--faint); min-width: 0.9rem; }
    .step.is-picked { color: var(--vellum); background: color-mix(in oklab, var(--rubric) 18%, transparent); }
    .step.is-picked .n { color: var(--rubric); }
    .step.is-next { border-color: color-mix(in oklab, var(--brass) 45%, transparent); }
    .plan { position: sticky; top: 4rem; }
    .planlist { list-style: none; margin: 0; padding: 0; counter-reset: s; }
    .planlist li {
      display: flex; gap: 0.45rem; align-items: center; padding: 0.25rem 0;
      border-bottom: 1px solid var(--line-soft); font-size: 0.82rem;
    }
    .pl-n { flex: 1; display: flex; flex-direction: column; line-height: 1.25; }
    .pl-n .subtle { font-size: 0.7rem; }
    .pl-c { font-family: var(--font-mono); font-size: 0.75rem; color: var(--brass); }
    .rm { background: none; border: none; color: var(--faint); cursor: pointer; font-size: 1rem; padding: 0 0.2rem; }
    .rm:hover { color: var(--bad); }
    .summary h3 { font-family: var(--font-display); font-size: 0.9rem; margin: 0.9rem 0 0.3rem; }
    .summary ul { margin: 0; padding-left: 1rem; color: var(--dim); font-size: 0.78rem; }
    .empty, .note { color: var(--faint); font-size: 0.8rem; }
    .note { margin: 0 0 0.5rem; }
    button { background: var(--panel); color: var(--vellum); border: 1px solid var(--line); border-radius: var(--r); padding: 0.28rem 0.7rem; cursor: pointer; font: 0.82rem var(--font-ui); }
    button:hover { border-color: var(--brass); color: var(--brass-bright); }
    .btn-primary { border-color: color-mix(in oklab, var(--rubric) 60%, var(--line)); }
    .hint b { color: var(--rubric); font-family: var(--font-mono); }
    .prov { color: var(--faint); font-size: 0.78rem; max-width: 64ch; margin-top: 2rem; }
  </style>
</Base>
