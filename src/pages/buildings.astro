---
import Base from '../layouts/Base.astro';
import BuildingChain from '../components/BuildingChain.astro';
import buildings from '../data/buildings.json';
import districtsData from '../data/districts.json';
import holdingsData from '../data/holdings.json';
import { getEntity } from '../lib/entities';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const D = districtsData as any;
const all = buildings as any[];
const holdingName: Record<string, string> = Object.fromEntries((holdingsData as any[]).map((h) => [h.id, h.name]));
const districtNames: Record<string, string> = Object.fromEntries(D.districts.map((x: any) => [x.id, x.name]));

// chain root id -> tiers sorted 1..N
const chainMap = new Map<string, any[]>();
for (const b of all) {
  if (!chainMap.has(b.chain)) chainMap.set(b.chain, []);
  chainMap.get(b.chain)!.push(b);
}
for (const tiers of chainMap.values()) tiers.sort((a, b) => a.tier - b.tier);
// a chain's home district (first that lists it) carries its #anchor here
const home = (chainId: string) => chainMap.get(chainId)?.[0]?.districts?.[0] ?? null;

const byType = new Map<string, any[]>();
for (const d of D.districts) {
  if (!byType.has(d.type)) byType.set(d.type, []);
  byType.get(d.type)!.push(d);
}
// special districts split by the district file they come from (the game's grouping)
const SPECIAL_ORDER = ['Special', 'Special mines', 'Legendary'];

const orphans = [...chainMap.values()].filter((t) => !(t[0].districts?.length));
const dlcs = [...new Set(D.districts.map((d: any) => d.dlc).filter(Boolean))].sort() as string[];

const terrainName = (t: string) => getEntity(`terrain_${t}`)?.name ?? t.replace(/_/g, ' ');
const chipName = (r: any) => (r.kind === 'terrain' ? terrainName(r.key) : r.name);

// the final tier's unconditional effects, for one-building (special) districts
function finalLines(chainId: string): string[] {
  const tiers = chainMap.get(chainId);
  if (!tiers) return [];
  const last = tiers[tiers.length - 1];
  return last.modifiers.filter((g: any) => !g.cond).flatMap((g: any) => g.lines);
}

function searchText(d: any): string {
  const parts = new Set<string>([d.id, d.name, d.category]);
  if (d.primaryBuilding) parts.add(d.primaryBuilding.name);
  for (const b of d.buildings) parts.add(b.name);
  for (const r of d.requirements) parts.add(r.name);
  for (const f of d.focus ?? []) parts.add(f);
  if (d.dlc) parts.add(d.dlc);
  return [...parts].join(' ').toLowerCase();
}
const ROMAN = ['', 'I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X', 'XI', 'XII'];
---
<Base
  title="Buildings"
  active="buildings"
  lede="Every district and the building lines inside it: holding districts, standard districts, resource, duchy, special and great districts, trade posts and entrepôts. Open a district for each line's tiers, costs, trade-good needs and market modifiers."
  stats={[
    { value: D.districts.length, label: 'districts' },
    { value: chainMap.size, label: 'building lines' },
    { value: all.length, label: 'buildings' },
  ]}
>
  {D.concept && (
    <blockquote class="concept">
      {D.concept.split('\n').filter(Boolean).map((p: string) => <p>{p}</p>)}
      <cite>— the game's District concept</cite>
    </blockquote>
  )}

  <div class="filterbar">
    <input type="search" id="q" placeholder="Filter by district, building, focus…" autocomplete="off" />
    <select id="ftype">
      <option value="">every district type</option>
      {D.types.map((t: any) => <option value={t.id}>{t.name}</option>)}
    </select>
    <select id="fdlc">
      <option value="">base game + DLC</option>
      <option value="base">base game only</option>
      {dlcs.map((d) => <option value={d}>{d}</option>)}
    </select>
    <span class="hint" id="count"></span>
  </div>

  {D.types.map((t: any) => {
    const list = byType.get(t.id) ?? [];
    if (!list.length) return null;
    const groups: [string, any[]][] = t.id === 'special'
      ? SPECIAL_ORDER.map((c) => [c, list.filter((d) => d.category === c)] as [string, any[]]).filter(([, l]) => l.length)
      : [[t.name, list]];
    const oneBuilding = list.every((d) => d.buildings.length === 0);
    return (
      <section data-type={t.id}>
        <h2 class="group-h" id={`type-${t.id}`}>{t.name}s <span class="count">{list.length}</span></h2>
        {t.desc && <p class="tdesc">{t.desc.split('\n').filter(Boolean)[0]}</p>}
        {groups.map(([gname, gl]) => (
          <div class="tgroup" data-group>
            {groups.length > 1 && <h3 class="sub-h">{gname} <span class="count">{gl.length}</span></h3>}
            <div class="tbl-scroll">
              <table class="ntbl">
                <thead>
                  <tr>
                    <th>District</th>
                    <th>Primary building</th>
                    <th>Where</th>
                    <th>{oneBuilding ? 'Effects at final tier' : 'Building lines'}</th>
                    <th>DLC</th>
                  </tr>
                </thead>
                <tbody>
                  {gl.map((d: any) => {
                    const pb = d.primaryBuilding;
                    const pbHome = pb && home(pb.id) === d.id;
                    const fx = oneBuilding && pb ? finalLines(pb.id) : [];
                    return (
                      <tr class="drow" id={d.id} data-name={searchText(d)} data-type={d.type} data-dlc={d.dlc ?? 'base'}>
                        <td class="name">
                          {d.icon && <img class="b-icon" src={`${base}/img/buildings/${d.icon}.webp`} alt="" width="24" height="24" loading="lazy" onerror="this.style.visibility='hidden'" />}
                          <a href={`${base}/buildings/${d.id}`}>{d.name}</a>
                          {d.focus?.length > 0 && <span class="focus">{d.focus.join(' · ')}</span>}
                        </td>
                        <td class="pb">
                          {pb && (
                            <a id={pbHome ? pb.id : undefined} data-go={pbHome ? `${base}/buildings/${d.id}#${pb.id}` : undefined}
                               href={`${base}/buildings/${d.id}#${pb.id}`}>{pb.name}</a>
                          )}
                          {pb?.tiers > 1 && <span class="subtle"> · {pb.tiers} tiers</span>}
                          {d.tierSlots?.some((s: any) => s) && (
                            <span class="slots" title="building slots by district tier (building_slots_for_host_district)">
                              slots {d.tierSlots.map((s: any) => s ?? 0).join('/')}
                            </span>
                          )}
                        </td>
                        <td class="where">
                          {d.holdings.length > 0 && (
                            <span class="hold">{d.holdings.map((h: any) => holdingName[h.id] ?? h.id).join(', ')}</span>
                          )}
                          {d.unlockedBy && <span class="subtle">after {d.unlockedBy.name}</span>}
                          <span class="chips">
                            {d.requirements.slice(0, 4).map((r: any) => (
                              <span class={r.kind === 'terrain' ? 'chip chip--terrain' : 'chip chip--req'} title={r.detail ?? r.kind.replace(/_/g, ' ')}>
                                {r.negated && <span class="neg">not </span>}{chipName(r)}
                              </span>
                            ))}
                            {d.requirements.length > 4 && <span class="subtle">+{d.requirements.length - 4}</span>}
                          </span>
                        </td>
                        <td class="lines">
                          {oneBuilding ? (
                            <>
                              {fx.slice(0, 3).map((l) => <span class="fx-line">{l}</span>)}
                              {fx.length > 3 && <span class="fx-line subtle">+{fx.length - 3} more…</span>}
                            </>
                          ) : (
                            <span class="chips">
                              {d.buildings.map((b: any) => {
                                const isHome = home(b.id) === d.id;
                                return (
                                  <a class="chip" id={isHome ? b.id : undefined}
                                     data-go={isHome ? `${base}/buildings/${d.id}#${b.id}` : undefined}
                                     href={`${base}/buildings/${d.id}#${b.id}`}
                                     title={`${b.tiers} tier${b.tiers === 1 ? '' : 's'}${b.dlc ? ` · ${b.dlc}` : ''}`}>{b.name}</a>
                                );
                              })}
                            </span>
                          )}
                        </td>
                        <td>{d.dlc ? <span class="badge-dlc">{d.dlc}</span> : <span class="subtle">—</span>}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>
        ))}
      </section>
    );
  })}

  {orphans.length > 0 && (
    <section data-type="none">
      <h2 class="group-h" id="type-none">In no district roster <span class="count">{orphans.length}</span></h2>
      <p class="tdesc">
        Defined in <code>common/buildings/</code> but named by no district's primary building or roster —
        placed by script effects (great-project stages, events) rather than built from a district.
      </p>
      {orphans.map((tiers) => (
        <div class="orphan" id={tiers[0].id}>
          <h3 class="sub-h">{tiers[0].name} <span class="count">{tiers[0].sourceFile}</span></h3>
          <BuildingChain tiers={tiers} districtNames={districtNames} />
        </div>
      ))}
    </section>
  )}

  <p class="prov">
    Districts from <code>common/districts/</code>; holding rosters from <code>common/holdings/</code>; buildings from
    every subfolder of <code>common/buildings/</code>. Requirement chips are the district's own
    <code>can_construct</code> / <code>is_enabled</code> triggers, with named scripted triggers resolved one level down.
    The DLC badge on special districts comes from their primary building.
  </p>

  <script>
    // Old links point at /buildings#<building>; send them to the district page.
    if (location.hash) {
      const el = document.getElementById(decodeURIComponent(location.hash.slice(1)));
      const go = el?.getAttribute('data-go');
      if (go) location.replace(go);
    }
    const q = document.getElementById('q') as HTMLInputElement;
    const ftype = document.getElementById('ftype') as HTMLSelectElement;
    const fdlc = document.getElementById('fdlc') as HTMLSelectElement;
    const count = document.getElementById('count')!;
    const rows = [...document.querySelectorAll<HTMLTableRowElement>('tr.drow')];
    const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')];
    const sections = [...document.querySelectorAll<HTMLElement>('section[data-type]')];
    function apply() {
      const needle = q.value.trim().toLowerCase();
      const t = ftype.value;
      const d = fdlc.value;
      let shown = 0;
      for (const r of rows) {
        const ok =
          (!needle || (r.dataset.name ?? '').includes(needle)) &&
          (!t || r.dataset.type === t) &&
          (!d || (d === 'base' ? r.dataset.dlc === 'base' : r.dataset.dlc === d));
        r.hidden = !ok;
        if (ok) shown++;
      }
      for (const g of groups) g.hidden = ![...g.querySelectorAll('tr.drow')].some((r) => !(r as HTMLElement).hidden);
      for (const s of sections) {
        if (s.dataset.type === 'none') { s.hidden = !!(needle || t || d); continue; }
        s.hidden = ![...s.querySelectorAll('tr.drow')].some((r) => !(r as HTMLElement).hidden);
      }
      count.textContent = `${shown} of ${rows.length} districts`;
    }
    for (const el of [q, ftype, fdlc]) el.addEventListener('input', apply);
    apply();
  </script>

  <style>
    .concept { margin: 0 0 1.2rem; padding: 0.2rem 0 0.2rem 0.9rem; border-left: 2px solid var(--rubric); color: var(--dim); font-size: 0.84rem; max-width: 75ch; }
    .concept p { margin: 0.25rem 0; }
    .concept cite { color: var(--faint); font-size: 0.74rem; font-style: normal; }
    .tdesc { color: var(--dim); font-size: 0.8rem; max-width: 75ch; margin: -0.2rem 0 0.6rem; font-style: italic; }
    .tdesc code, .prov code { font-family: var(--font-mono); font-size: 0.95em; font-style: normal; }
    .sub-h { font-size: 0.85rem; color: var(--dim); margin: 0.8rem 0 0.3rem; font-weight: 600; }
    .sub-h .count { color: var(--faint); font-family: var(--font-mono); font-size: 0.72rem; font-weight: 400; }
    .ntbl td.name { white-space: normal; min-width: 12rem; }
    .b-icon { vertical-align: -7px; margin-right: 0.35rem; }
    .focus { display: block; color: var(--faint); font-size: 0.7rem; margin-top: 0.1rem; }
    .pb { white-space: normal; min-width: 9rem; font-size: 0.82rem; }
    .slots { display: block; font-family: var(--font-mono); font-size: 0.68rem; color: var(--faint); }
    .where { white-space: normal; font-size: 0.78rem; min-width: 10rem; max-width: 18rem; }
    .where > span { display: block; }
    .hold { color: var(--dim); }
    .lines .chips { max-width: 34rem; }
    .lines .chip { border-bottom: none; font-size: 0.74rem; }
    .fx-line { display: block; font-size: 0.78rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 22rem; }
    .chip .neg { color: var(--bad); }
    .orphan { margin-bottom: 1rem; }
    .prov { color: var(--faint); font-size: 0.78rem; max-width: 70ch; margin-top: 2rem; }
  </style>
</Base>
