---
import Base from '../layouts/Base.astro';
import Backlinks from '../components/Backlinks.astro';
import data from '../data/faiths.json';
import startworld from '../data/startworld.json';
import doctrinesData from '../data/doctrines.json';

const startFaiths = (startworld as any).faiths;
const startRites = (startworld as any).rites ?? {};

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const { families, religions, faiths, rites, concepts, tenetStatusNames } = data as any;
const riteById = new Map<string, any>(rites.map((r: any) => [r.id, r]));
const faithById = new Map<string, any>(faiths.map((f: any) => [f.id, f]));
const ritesOf = (fid: string) => rites.filter((r: any) => r.faith === fid);
// tenet stances: history/faiths entries, later dates overwrite (per _faith_history.info)
function stances(f: any) {
  const st = new Map<string, { name: string; status: string; date: string }>();
  for (const e of f.history ?? []) {
    for (const s of ['known', 'permitted', 'prohibited'])
      for (const t of e[s]) st.set(t.key, { name: t.name, status: s, date: e.date });
  }
  const by: Record<string, { name: string; date: string }[]> = { permitted: [], prohibited: [], known: [] };
  for (const v of st.values()) by[v.status].push(v);
  for (const k in by) by[k].sort((a, b) => a.name.localeCompare(b.name));
  return by;
}
const membership = (f: any, rid: string) => f.riteMembership.find((m: any) => m.id === rid);
const docName = new Map<string, string>((doctrinesData as any).doctrines.map((d: any) => [d.id, d.name]));
const dName = (k: string) => docName.get(k) ?? k;
// doctrines a rite holds that differ from its faith's effective (mainline) set
const distinct = (r: any) => {
  const f = faithById.get(r.faith);
  if (!f) return r.effectiveDoctrines;
  return r.effectiveDoctrines.filter((d: string) => !f.doctrines.includes(d));
};
const riteRows = [...rites].sort((a: any, b: any) => {
  const fa = faithById.get(a.faith), fb = faithById.get(b.faith);
  return (fa?.family ?? '').localeCompare(fb?.family ?? '') ||
    (fa?.religion ?? '').localeCompare(fb?.religion ?? '') ||
    (fa?.name ?? '').localeCompare(fb?.name ?? '') ||
    Number(b.id === fa?.mainRite) - Number(a.id === fa?.mainRite) ||
    (a.name ?? '').localeCompare(b.name ?? '');
});
const FAMILY_ORDER = ['rf_abrahamic', 'rf_eastern', 'rf_sinitic', 'rf_pagan'];
const orderedFamilies = [...families].sort(
  (a, b) => FAMILY_ORDER.indexOf(a.id) - FAMILY_ORDER.indexOf(b.id)
);
const religionsOf = (fam: string) => religions.filter((r) => r.family === fam);
const faithsOf = (rel: string) => faiths.filter((f: any) => f.religion === rel);

const tw = (t: any) => `${t.name}${t.weight !== 1 ? ` (${t.weight})` : ''}`;
const traitText = (r: any) =>
  [
    r.virtues.length ? `Virtues: ${r.virtues.map(tw).join(', ')}` : null,
    r.sins.length ? `Sins: ${r.sins.map(tw).join(', ')}` : null,
  ]
    .filter(Boolean)
    .join(' · ');
---
<Base
  title="Faiths"
  active="faiths"
  lede="Every faith and rite, grouped by religion family and religion: each faith's rites (the mainline one marked), the core tenets of its mainline rite, its Eminent and regular holy sites, religious head, and the virtues and sins of its religion. Read from faith_types, rite_types and history/faiths."
  stats={[
    { value: faiths.length, label: 'faiths' },
    { value: rites.length, label: 'rites' },
    { value: religions.length, label: 'religions' },
    { value: families.length, label: 'families' },
  ]}
>
  <div class="filterbar">
    <input type="search" id="q" placeholder="Filter by faith, tenet, holy site…" autocomplete="off" />
    <select id="ffam">
      <option value="">every family</option>
      {orderedFamilies.map((f) => <option value={f.id}>{f.name}</option>)}
    </select>
    <span class="hint" id="count"></span>
  </div>

  <div class="concepts">
    {['rite', 'mainline_rite'].map((k) => concepts[k]?.desc && (
      <details>
        <summary>{concepts[k].name} <span class="subtle">— the game's own description</span></summary>
        <p class="concept-text">{concepts[k].desc}</p>
      </details>
    ))}
  </div>

  {orderedFamilies.map((fam) => (
    <section data-family={fam.id}>
      <h2 class="group-h" id={fam.id}>
        {fam.name}
        <span class="count">{religionsOf(fam.id).reduce((n, r) => n + faithsOf(r.id).length, 0)}</span>
      </h2>
      {religionsOf(fam.id).map((rel) => (
        <section data-group={rel.id}>
          <h3 class="rel-h" id={rel.id}>
            {rel.name}
            <span class="count">{faithsOf(rel.id).length}</span>
            {traitText(rel) && <span class="rel-traits">{traitText(rel)}</span>}
          </h3>
          <div class="tbl-scroll">
            <table class="ntbl">
              <thead>
                <tr>
                  <th>Faith</th>
                  <th>Rites</th>
                  <th title="Core tenets of the mainline rite">Tenets</th>
                  <th title="❧ = Eminent: also grants faith-wide bonuses">Holy sites</th>
                  <th>Head of faith</th>
                  <th title="Provinces at the scripted world setup">At start</th>
                </tr>
              </thead>
              <tbody>
                {faithsOf(rel.id).map((f: any) => (
                  <tr
                    id={f.id}
                    data-name={`${f.name} ${f.adherent ?? ''} ${f.rites.map((r: string) => riteById.get(r)?.name ?? r).join(' ')} ${f.tenets.map((t: any) => t.name).join(' ')} ${f.holySites.map((h: any) => h.name).join(' ')}`.toLowerCase()}
                    data-family={f.family}
                  >
                    <td class="name">
                      <span class="faith">
                        <span class="dot" style={`--c:${f.color ?? 'var(--faint)'}`} />
                        <span>
                          <img class="row-icon" src={`${base}/img/faith/${f.id}.webp`} alt="" width="26" height="26" loading="lazy" onerror="this.hidden=true" />
                          <span class="u-name">{f.name}</span>
                          {f.adherent && f.adherent !== f.name && (
                            <span class="u-sub"><br />{f.adherent}</span>
                          )}
                          {f.historical && <span class="u-sub"><br />historical</span>}
                        </span>
                      </span>
                      {(() => {
                        const st = stances(f);
                        const n = st.permitted.length + st.prohibited.length + st.known.length;
                        return n > 0 && (
                          <details class="stances">
                            <summary>tenet stances ({n})</summary>
                            {(['permitted', 'prohibited', 'known'] as const).map((s) => st[s].length > 0 && (
                              <div><span class={`st st--${s}`}>{tenetStatusNames[s]}</span> {st[s].map((t) => t.name).join(', ')}</div>
                            ))}
                          </details>
                        );
                      })()}
                    </td>
                    <td>
                      <span class="chips">
                        {f.rites.map((rid: string) => {
                          const r = riteById.get(rid);
                          const m = membership(f, rid);
                          const isMain = rid === f.mainRite;
                          const dated = f.mainRiteByDate.filter((x: any) => x.rite === rid).map((x: any) => x.date);
                          return (
                            <a
                              class:list={['chip', { 'chip--main': isMain || dated.length }]}
                              href={`#rite-${rid}`}
                              title={[
                                isMain ? `mainline rite (${f.mainRiteSource})` : null,
                                dated.length ? `mainline from ${dated.join(', ')}` : null,
                                m?.from ? `joins this faith ${m.from}` : null,
                              ].filter(Boolean).join('; ') || undefined}
                            >
                              {(isMain || dated.length > 0) && <span class="x">❧</span>}
                              {r?.name ?? rid}
                              {m?.from && <span class="subtle"> {m.from.split('.')[0]}</span>}
                            </a>
                          );
                        })}
                      </span>
                    </td>
                    <td>
                      <span class="chips">
                        {f.tenets.map((t: any) => (
                          <a
                            class:list={['chip', 'chip--tenet', { 'chip--dlc': t.dlc }]}
                            href={`${base}/doctrines#${t.key}`}
                            title={t.dlc ? `with ${t.dlc}${t.fallbackName ? `; otherwise ${t.fallbackName}` : ''}` : undefined}
                          >
                            {t.name}
                          </a>
                        ))}
                      </span>
                    </td>
                    <td>
                      <span class="chips">
                        {f.holySites.map((h: any) => (
                          <a class:list={['chip', { 'chip--counter': h.eminent }]} href={`${base}/holy-sites#${h.key}`} title={h.eminent ? concepts.eminent_holy_site.name : undefined}>
                            {h.eminent && <span class="x">❧</span>}{h.name}
                          </a>
                        ))}
                      </span>
                    </td>
                    <td>
                      {f.religiousHead ? f.religiousHead.name ?? f.religiousHead.title : <span class="subtle">—</span>}
                      {f.headOfRite && <span class="u-sub"><br />head of rite: {f.headOfRite.name ?? f.headOfRite.title}</span>}
                    </td>
                    <td class="start">
                      {startFaiths[f.id] ? (
                        <span title={startFaiths[f.id].regions.map((r: any) => `${r.name} (${r.n})`).join(', ')}>
                          <b>{startFaiths[f.id].provinces}</b>
                          <span class="subtle"> prov · {startFaiths[f.id].counties} counties</span>
                        </span>
                      ) : (
                        <span class="subtle">not on the map</span>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      ))}
    </section>
  ))}

  <section data-group="rites">
    <h2 class="group-h" id="rites">
      Rites
      <span class="count">{rites.length}</span>
    </h2>
    <p class="note">
      A rite's doctrines are its religion's, then its faith's, then its own: a later layer replaces the doctrine
      of the same group (<code>_rite_types.info</code>). "Differs from mainline" lists the doctrines where the
      rite departs from its faith's mainline rite. A rite is listed under the faith its rite type names;
      <code>history/faiths</code> can move it to another faith at a later date (shown with →).
    </p>
    <div class="tbl-scroll">
      <table class="ntbl">
        <thead>
          <tr>
            <th>Rite</th>
            <th>Faith</th>
            <th>Core tenets</th>
            <th>Differs from mainline</th>
            <th>Founder · cultures</th>
            <th title="Provinces at the scripted world setup">At start</th>
          </tr>
        </thead>
        <tbody>
          {riteRows.map((r: any) => {
            const f = faithById.get(r.faith);
            const diff = distinct(r);
            return (
              <tr
                id={`rite-${r.id}`}
                data-name={`${r.name ?? r.id} ${r.adherent ?? ''} ${f?.name ?? ''} ${r.tenets.map((t: any) => t.name).join(' ')}`.toLowerCase()}
                data-family={f?.family}
              >
                <td class="name">
                  <span class="faith">
                    <span class="dot" style={`--c:${r.color ?? 'var(--faint)'}`} />
                    <span>
                      <span class="u-name">{r.name ?? r.id}</span>
                      {r.mainOf.length > 0 && <span class="main-mark" title={`mainline rite of ${r.mainOf.map((x: string) => faithById.get(x)?.name ?? x).join(', ')}`}> ❧</span>}
                      {r.adherent && r.adherent !== r.name && <span class="u-sub"><br />{r.adherent}</span>}
                      {!r.convert && <span class="u-sub"><br />cannot be converted to</span>}
                      {r.historyOnly && <span class="u-sub"><br />history only</span>}
                      {!r.create && <span class="u-sub"><br />created only by history</span>}
                    </span>
                  </span>
                  {r.desc && <div class="desc">{r.desc}</div>}
                </td>
                <td>
                  {f ? <a href={`#${f.id}`}>{f.name}</a> : <span class="subtle">{r.faith}</span>}
                  {r.historyFaiths.map((h: any) => (
                    <span class="u-sub"><br />→ <a href={`#${h.faith}`}>{faithById.get(h.faith)?.name ?? h.faith}</a> from {h.from}</span>
                  ))}
                </td>
                <td>
                  <span class="chips">
                    {r.tenets.map((t: any) => (
                      <a
                        class:list={['chip', 'chip--tenet', { 'chip--dlc': t.dlc }]}
                        href={`${base}/doctrines#${t.key}`}
                        title={t.dlc ? `with ${t.dlc}${t.fallbackName ? `; otherwise ${t.fallbackName}` : ''}` : undefined}
                      >{t.name}</a>
                    ))}
                    {r.tenets.length === 0 && <span class="subtle">—</span>}
                  </span>
                </td>
                <td>
                  <span class="chips">
                    {diff.map((d: string) => <a class="chip" href={`${base}/doctrines#${d}`}>{dName(d)}</a>)}
                    {diff.length === 0 && <span class="subtle">—</span>}
                  </span>
                </td>
                <td>
                  {r.founder && <span>{r.founder.name ?? r.founder.title}</span>}
                  {r.cultures.length > 0 && <span class="u-sub">{r.founder && <br />}{r.cultures.map((c: any) => c.name).join(', ')}</span>}
                  {!r.founder && r.cultures.length === 0 && <span class="subtle">—</span>}
                </td>
                <td class="start">
                  {startRites[r.id] ? (
                    <span title={startRites[r.id].regions.map((x: any) => `${x.name} (${x.n})`).join(', ')}>
                      <b>{startRites[r.id].provinces}</b>
                      <span class="subtle"> prov · {startRites[r.id].counties} counties</span>
                    </span>
                  ) : (
                    <span class="subtle">not on the map</span>
                  )}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  <script>
    const q = document.getElementById('q') as HTMLInputElement;
    const ffam = document.getElementById('ffam') as HTMLSelectElement;
    const count = document.getElementById('count')!;
    const rows = [...document.querySelectorAll<HTMLTableRowElement>('tbody tr')];
    const groups = [...document.querySelectorAll<HTMLElement>('section[data-group]')];
    const fams = [...document.querySelectorAll<HTMLElement>('section[data-family]')];

    function apply() {
      const needle = q.value.trim().toLowerCase();
      const fam = ffam.value;
      let shown = 0;
      for (const r of rows) {
        const ok =
          (!needle || (r.dataset.name ?? '').includes(needle)) &&
          (!fam || r.dataset.family === fam);
        r.hidden = !ok;
        if (ok) shown++;
      }
      for (const g of groups) {
        g.hidden = ![...g.querySelectorAll('tbody tr')].some((r) => !(r as HTMLTableRowElement).hidden);
      }
      for (const g of fams) {
        g.hidden = ![...g.querySelectorAll('section[data-group]')].some((s) => !(s as HTMLElement).hidden);
      }
      count.textContent = `${shown} of ${rows.length}`;
    }
    for (const el of [q, ffam]) el.addEventListener('input', apply);
    apply();
  </script>

  <style>
    .rel-h {
      display: flex; align-items: baseline; gap: 0.5rem; flex-wrap: wrap;
      font-family: var(--font-display); font-weight: 600; font-size: 0.95rem;
      margin: 1.2rem 0 0.4rem;
    }
    .rel-h .count { color: var(--faint); font-family: var(--font-mono); font-size: 0.72rem; }
    .rel-traits { color: var(--faint); font-family: var(--font-ui); font-weight: 400; font-size: 0.75rem; }
    .faith { display: flex; align-items: center; gap: 0.5rem; }
    .faith .dot {
      width: 11px; height: 11px; border-radius: 50%; flex: none;
      background: var(--c, var(--faint));
      box-shadow: 0 0 0 1px color-mix(in oklab, var(--vellum) 25%, transparent);
    }
    .chip--tenet { border-color: color-mix(in oklab, var(--rubric) 40%, var(--line)); }
    .chip--dlc { border-style: dashed; cursor: help; }
    .chip--main { border-color: color-mix(in oklab, var(--rubric) 45%, var(--line)); }
    .chip .x, .main-mark { color: var(--rubric); margin-right: 0.2rem; }
    .stances { font-size: 0.72rem; color: var(--dim); margin-top: 0.3rem; max-width: 30rem; white-space: normal; }
    .stances summary { cursor: pointer; color: var(--faint); }
    .st { font-family: var(--font-mono); font-size: 0.66rem; color: var(--faint); }
    .st--permitted { color: var(--good); }
    .st--prohibited { color: var(--bad); }
    td.name .desc { color: var(--faint); font-size: 0.75rem; max-width: 40ch; margin-top: 0.15rem; white-space: normal; }
    .note { color: var(--faint); font-size: 0.78rem; max-width: 70ch; }
    .note code { font-family: var(--font-mono); }
    .concepts { margin: 0.4rem 0 1rem; max-width: 72ch; }
    .concepts summary { cursor: pointer; color: var(--brass); font-size: 0.85rem; }
    .concept-text { white-space: pre-line; color: var(--dim); font-size: 0.82rem; }
  </style>

  <Backlinks ids={faiths.map((x: any) => x.id)} />
</Base>
<style is:global>
  .start { font-size: 0.78rem; white-space: nowrap; }
  .start b { font-family: var(--font-mono); color: var(--brass); }
</style>

<style is:global>
  .row-icon { vertical-align: -7px; margin-right: 0.4rem; }
</style>
