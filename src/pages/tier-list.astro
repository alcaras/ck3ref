---
import Base from '../layouts/Base.astro';
import tiers from '../data/tiers.json';

const meta = tiers.meta as any;
const eras = (meta.eras as string[]).map((k) => ({
  id: k, name: k.replace('culture_era_', '').replace(/_/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()),
}));
const BASES = [
  { key: 'overall', label: 'Overall', blurb: 'Average of the three bases below — good however you measure it.' },
  { key: 'regiments', label: 'Per regiment', blurb: `${meta.equalRegiments} regiments each — raw strength for one men-at-arms slot.` },
  { key: 'recruit', label: 'Per recruitment gold', blurb: `As many regiments as ${meta.recruitCap} gold buys — up-front cost efficiency.` },
  { key: 'maintenance', label: 'Per upkeep gold', blurb: `As many regiments as ${meta.maintCap} gold/month sustains — standing-army efficiency.` },
];
---
<Base
  title="Men-at-Arms Tier List"
  active="tier-list"
  lede="Every normally-recruitable troop type, ranked S to D by how it fares against the whole roster — mono-type armies fought on the average CK3 map (province-weighted terrain, 50/50 attacking and defending). Pick an era: units appear only once their innovation/tradition unlocks them, and their stats scale with era (longbowmen go 20→50 damage). Four rankings — one regiment slot, a recruitment budget, or a monthly upkeep budget."
  stats={[
    { value: eras.length, label: 'eras' },
    { value: '4', label: 'rankings' },
    { value: 'S–D', label: 'tiers' },
  ]}
>
  <div class="ctrls">
    <label>Era
      <select id="era">
        {eras.map((e) => <option value={e.id} selected={e.id === 'culture_era_late_medieval'}>{e.name}</option>)}
      </select>
    </label>
    <div class="tabs" role="tablist">
      {BASES.map((b, i) => <button class:list={['ttab', { active: i === 0 }]} data-basis={b.key}>{b.label}</button>)}
    </div>
  </div>

  <p class="blurb subtle" id="blurb"></p>
  <div class="tiers" id="tiers"></div>

  <p class="legend subtle">
    Score = the share of the era's roster a unit beats, averaged over every terrain (weighted by how common it
    is on the map) and both roles (attacking and defending), using the same decompiled engine as the
    <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/battle-simulator`}>Battle Simulator</a>. Tiers are
    rank bands within each list, so S is always the top ~12%; the % on each chip is the real win rate,
    <strong>×N</strong> is the regiments that budget fields, and each unit links to its detail page (how to
    unlock it, stat progression, raw definition). Single-regiment accolade units, siege weapons, and units a
    normal feudal kingdom can't field (holy-order, decision-, or domicile-locked) are excluded.
  </p>

  <script>
    import data from '../data/tiers.json';
    const base = import.meta.env.BASE_URL.replace(/\/$/, '');
    const byEra = (data as any).byEra;
    const TIERS = ['S', 'A', 'B', 'C', 'D'];
    const BLURB: Record<string, string> = {
      overall: 'Average of the three bases — good however you measure it.',
      regiments: `${(data as any).meta.equalRegiments} regiments each — raw strength for one men-at-arms slot.`,
      recruit: `As many regiments as ${(data as any).meta.recruitCap} gold buys — up-front cost efficiency.`,
      maintenance: `As many regiments as ${(data as any).meta.maintCap} gold/month sustains — standing-army efficiency.`,
    };
    const $ = (s: string) => document.querySelector(s) as HTMLElement;

    function render() {
      const era = ($('#era') as HTMLSelectElement).value;
      const basis = (document.querySelector('.ttab.active') as HTMLElement).dataset.basis!;
      $('#blurb').textContent = BLURB[basis];
      const list = byEra[era][basis] as any[];
      const groups: Record<string, any[]> = Object.fromEntries(TIERS.map((t) => [t, []]));
      for (const u of list) groups[u.tier].push(u);
      $('#tiers').innerHTML = TIERS.map((t) => {
        const chips = groups[t].length
          ? groups[t].map((u) =>
              `<a class="unit" href="${base}/men-at-arms/${u.id}" title="${u.name} — beats ${u.winPct}% of the field${u.regiments ? ` · ${u.regiments} regiments` : ''}">` +
              `<span class="uname">${u.name}</span><span class="uwin">${u.winPct}%</span>${u.regiments ? `<span class="ureg">×${u.regiments}</span>` : ''}</a>`).join('')
          : '<span class="empty subtle">—</span>';
        return `<div class="tierrow t-${t}"><div class="tlabel">${t}</div><div class="tunits">${chips}</div></div>`;
      }).join('');
    }

    for (const tab of document.querySelectorAll<HTMLElement>('.ttab')) {
      tab.addEventListener('click', () => {
        for (const t of document.querySelectorAll('.ttab')) t.classList.toggle('active', t === tab);
        render();
      });
    }
    $('#era').addEventListener('input', render);
    render();
  </script>

  <style>
    .ctrls { display: flex; gap: 1.2rem; align-items: center; flex-wrap: wrap; margin-bottom: 1rem; border-bottom: 1px solid var(--line); padding-bottom: 0.7rem; }
    .ctrls > label { color: var(--dim); font-size: 0.8rem; display: flex; gap: 0.4rem; align-items: center; }
    select { background: var(--ink); color: var(--vellum); border: 1px solid var(--line); border-radius: var(--r); padding: 0.3rem 0.5rem; font: 0.85rem var(--font-ui); }
    .tabs { display: flex; gap: 0.4rem; flex-wrap: wrap; }
    .ttab { background: var(--panel); color: var(--dim); border: 1px solid var(--line); border-radius: var(--r); padding: 0.35rem 0.8rem; cursor: pointer; font: 0.85rem var(--font-ui); }
    .ttab:hover { color: var(--brass-bright); border-color: var(--brass); }
    .ttab.active { background: var(--rubric); color: var(--vellum); border-color: var(--rubric); }
    .blurb { margin: 0 0 0.9rem; font-size: 0.85rem; }
    .tiers { display: flex; flex-direction: column; gap: 0.4rem; }
    /* tier rows are injected via innerHTML, so their styles must be global or Astro's
       scoped hashing drops them (they'd render as a plain unstyled list). */
    :global(.tierrow) { display: flex; gap: 0.6rem; align-items: stretch; }
    :global(.tlabel) { flex: 0 0 2.6rem; display: flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-weight: 700; font-size: 1.1rem; border-radius: var(--r); color: var(--ink); }
    :global(.t-S) .tlabel, :global(.t-S .tlabel) { background: #d3ac63; }
    :global(.t-A .tlabel) { background: #b6905a; }
    :global(.t-B .tlabel) { background: #9aa06a; } :global(.t-C .tlabel) { background: #8a8172; } :global(.t-D .tlabel) { background: #a06a5a; }
    :global(.tunits) { flex: 1; display: flex; flex-wrap: wrap; gap: 0.35rem; align-content: flex-start; padding: 0.3rem; background: var(--panel); border: 1px solid var(--line-soft); border-radius: var(--r); min-height: 2.2rem; }
    :global(.tunits .unit) { display: inline-flex; align-items: baseline; gap: 0.3rem; background: var(--panel-2); border: 1px solid var(--line); border-radius: var(--r); padding: 0.2rem 0.5rem; font-size: 0.8rem; text-decoration: none; }
    :global(.tunits .unit:hover) { border-color: var(--brass); }
    :global(.tunits .uname) { color: var(--vellum); }
    :global(.tunits .uwin) { color: var(--brass); font-family: var(--font-mono); font-size: 0.72rem; }
    :global(.tunits .ureg) { color: var(--dim); font-family: var(--font-mono); font-size: 0.68rem; }
    :global(.tunits .empty) { padding: 0.2rem 0.4rem; }
    .legend { font-size: 0.8rem; line-height: 1.55; margin-top: 1.4rem; max-width: 72ch; }
  </style>
</Base>
