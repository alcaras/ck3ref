---
import Base from '../layouts/Base.astro';
import maa from '../data/maa.json';
import { getEntity } from '../lib/entities';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const units = maa
  .filter((m) => !m.specialRecruitOnly)
  .map((m) => ({
    id: m.id, name: m.name, type: m.type, stats: m.stats, stack: m.stack ?? 100,
    terrain: m.terrainBonus, winter: m.winterBonus, counters: m.counters,
    gold: typeof m.buyCost?.gold === 'number' ? m.buyCost.gold : null,
    maint: typeof m.highMaintenance?.gold === 'number' ? m.highMaintenance.gold : null,
  }));
const terrains = [...new Set(units.flatMap((u) => Object.keys(u.terrain)))].sort();
const terrainName = (t: string) => getEntity(`terrain_${t}`)?.name ?? t.replace(/_/g, ' ');
const typeName = (t: string) => getEntity(`maa_type_${t}`)?.name ?? t;
---
<Base
  title="Army Builder"
  active="army-builder"
  lede="Compose an army and see its effective stats on any terrain, in winter, and against an enemy composition — with counter matchups flagged before you march."
  stats={[
    { value: units.length, label: 'recruitable types' },
    { value: terrains.length, label: 'terrains with bonuses' },
  ]}
>
  <div class="filterbar">
    <label>Terrain
      <select id="terrain">
        <option value="">open field (no bonus)</option>
        {terrains.map((t) => <option value={t}>{terrainName(t)}</option>)}
      </select>
    </label>
    <label>Winter
      <select id="winter">
        <option value="">none</option>
        <option value="normal_winter">winter</option>
        <option value="harsh_winter">harsh winter</option>
      </select>
    </label>
    <span class="hint">counter rule: a countered regiment loses up to 90% damage at 2:1 counter ratio (defines)</span>
  </div>

  <div class="armies">
    {['yours', 'enemy'].map((side) => (
      <section class="army" data-side={side}>
        <h2 class="group-h">{side === 'yours' ? 'Your army' : 'Enemy army'}</h2>
        <div class="addrow">
          <select class="unitpick">
            {units.map((u) => <option value={u.id}>{u.name} ({typeName(u.type)})</option>)}
          </select>
          <button class="add">Add regiment</button>
        </div>
        <table class="ntbl comp">
          <thead><tr><th>Regiment</th><th class="num">#</th><th class="num" title="effective damage">Dmg</th><th class="num" title="effective toughness">Tough</th><th></th><th></th></tr></thead>
          <tbody></tbody>
          <tfoot>
            <tr><td>Total</td><td class="num t-n"></td><td class="num t-d"></td><td class="num t-t"></td><td colspan="2" class="t-cost subtle"></td></tr>
          </tfoot>
        </table>
        <div class="warnings"></div>
      </section>
    ))}
  </div>

  <script define:vars={{ unitsJson: units }}>
    const U = new Map(unitsJson.map((u) => [u.id, u]));
    const state = { yours: [], enemy: [] };
    const terrainSel = document.getElementById('terrain');
    const winterSel = document.getElementById('winter');

    function eff(u) {
      let d = u.stats.damage, t = u.stats.toughness;
      const tb = u.terrain[terrainSel.value];
      if (tb) { d += tb.damage ?? 0; t += tb.toughness ?? 0; }
      const wb = u.winter[winterSel.value];
      if (wb) { d += wb.damage ?? 0; t += wb.toughness ?? 0; }
      return { d: Math.max(0, d), t: Math.max(0, t) };
    }

    // counter pressure on `unit` from the opposing composition:
    // ratio of countering sub-regiments to this unit's sub-regiments,
    // capped at 90% damage reduction at a 2:1 ratio (defines:
    // MEN_AT_ARMS_MAX_COUNTER 0.9, RATIO_FOR_MAX_COUNTER 2.0).
    function counterFactor(unit, mine, theirs) {
      const myCount = mine.filter((r) => r.id === unit.id).length || 1;
      let countering = 0;
      for (const r of theirs) {
        const cu = U.get(r.id);
        const val = cu.counters[unit.type];
        if (val) countering += val;
      }
      if (!countering) return 0;
      const ratio = countering / myCount;
      return Math.min(0.9, (ratio / 2.0) * 0.9);
    }

    function render() {
      for (const side of ['yours', 'enemy']) {
        const other = side === 'yours' ? 'enemy' : 'yours';
        const sec = document.querySelector(`[data-side=${side}]`);
        const tbody = sec.querySelector('tbody');
        tbody.innerHTML = '';
        let td = 0, tt = 0, gold = 0, maint = 0;
        const counted = new Map();
        for (const r of state[side]) counted.set(r.id, (counted.get(r.id) ?? 0) + 1);
        for (const [id, n] of counted) {
          const u = U.get(id);
          const e = eff(u);
          const cf = counterFactor(u, state[side], state[other]);
          const dEff = e.d * (1 - cf);
          td += dEff * n; tt += e.t * n;
          if (u.gold) gold += u.gold * n;
          if (u.maint) maint += u.maint * n;
          const tr = document.createElement('tr');
          tr.innerHTML = `<td>${u.name}${cf ? ` <span class="ctr" title="damage reduced by enemy counters">−${Math.round(cf * 100)}%</span>` : ''}</td>` +
            `<td class="num">${n}</td><td class="num">${Math.round(dEff)}</td><td class="num">${Math.round(e.t)}</td>` +
            `<td><button class="minus" data-id="${id}">−</button></td><td><button class="plus" data-id="${id}">+</button></td>`;
          tbody.appendChild(tr);
        }
        sec.querySelector('.t-n').textContent = state[side].length;
        sec.querySelector('.t-d').textContent = Math.round(td);
        sec.querySelector('.t-t').textContent = Math.round(tt);
        sec.querySelector('.t-cost').textContent = gold ? `${Math.round(gold)} gold · ${maint.toFixed(1)}/mo raised` : '';
        const w = sec.querySelector('.warnings');
        const hits = [];
        for (const [id] of counted) {
          const u = U.get(id);
          const cf = counterFactor(u, state[side], state[other]);
          if (cf >= 0.3) hits.push(`${u.name} is heavily countered (−${Math.round(cf * 100)}% damage)`);
        }
        w.innerHTML = hits.map((h) => `<div class="warn">${h}</div>`).join('');
      }
    }

    for (const sec of document.querySelectorAll('.army')) {
      const side = sec.dataset.side;
      sec.querySelector('.add').addEventListener('click', () => {
        state[side].push({ id: sec.querySelector('.unitpick').value });
        render();
      });
      sec.addEventListener('click', (e) => {
        const b = e.target.closest('button[data-id]');
        if (!b) return;
        if (b.classList.contains('plus')) state[side].push({ id: b.dataset.id });
        else {
          const i = state[side].findIndex((r) => r.id === b.dataset.id);
          if (i >= 0) state[side].splice(i, 1);
        }
        render();
      });
    }
    for (const el of [terrainSel, winterSel]) el.addEventListener('input', render);
    render();
  </script>

  <style>
    .armies { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
    @media (max-width: 900px) { .armies { grid-template-columns: 1fr; } }
    .addrow { display: flex; gap: 0.5rem; margin-bottom: 0.6rem; }
    .addrow select, .filterbar label select { background: var(--ink); color: var(--vellum); border: 1px solid var(--line); border-radius: var(--r); padding: 0.28rem 0.5rem; font-size: 0.85rem; }
    .filterbar label { color: var(--dim); font-size: 0.8rem; display: flex; gap: 0.4rem; align-items: center; }
    button { background: var(--panel); color: var(--vellum); border: 1px solid var(--line); border-radius: var(--r); padding: 0.25rem 0.6rem; cursor: pointer; font: 0.82rem var(--font-ui); }
    button:hover { border-color: var(--brass); color: var(--brass-bright); }
    .comp .minus, .comp .plus { padding: 0 0.45rem; }
    .comp tfoot td { border-top: 1px solid var(--line); font-weight: 600; }
    .ctr { color: var(--rubric); font-family: var(--font-mono); font-size: 0.72rem; }
    .warn { color: var(--bad); font-size: 0.8rem; margin-top: 0.3rem; }
    .warn::before { content: '⚔ '; }
  </style>
</Base>
