---
import '../styles/theme.css';
import { SECTIONS, TABS } from '../data/tabs';
import patch from '../../data/patch.json';

interface Props {
  title: string;
  /** Overrides the browser-tab title; defaults to "<title> — CK3 Reference". */
  docTitle?: string;
  active?: string;
  lede?: string;
  stats?: { label: string; value: string | number }[];
}
const { title, docTitle, active, lede, stats = [] } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const versal = title.slice(0, 1);
const rest = title.slice(1);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{docTitle ?? `${title} — CK3 Reference`}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Inter:wght@400;600&family=JetBrains+Mono:wght@400&display=swap"
    />
  </head>
  <body>
    <header class="hdr">
      <a class="hdr__title" href={`${base}/`}><span class="rubric">C</span>K3 Reference</a>
      <div class="search">
        <input id="global-search" type="search" placeholder="Search… ( / )" autocomplete="off"
          aria-label="Search the reference" />
        <div id="search-results" class="search__results" hidden></div>
      </div>
      <nav class="nav" aria-label="Sections">
        {SECTIONS.map((section) => (
          <details>
            <summary>{section}</summary>
            <div class="menu">
              {TABS.filter((t) => t.section === section).map((t) =>
                t.status === 'built' ? (
                  <a href={`${base}/${t.slug}`} class:list={[{ 'is-active': t.slug === active }]}>{t.label}</a>
                ) : (
                  <a href={`${base}/${t.slug}`}>{t.label}<span class="soon">planned</span></a>
                )
              )}
            </div>
          </details>
        ))}
      </nav>
    </header>
    <main class="wrap">
      <div class="page-meta">
        <h1><span class="versal">{versal}</span>{rest}</h1>
        {lede && <p class="lede">{lede}</p>}
        {stats.length > 0 && (
          <div class="pills">
            {stats.map((s) => (
              <span class="pill"><b>{s.value}</b> {s.label}</span>
            ))}
          </div>
        )}
      </div>
      <slot />
    </main>
    <footer class="foot">
      <span>ck3reference · data generated from the game's own files</span>
      <span>game build {patch.buildId}{patch.syncedAt ? ` · synced ${patch.syncedAt.slice(0, 10)}` : ''}</span>
    </footer>
    <script>
      // close any open nav dropdown when another opens or on outside click
      const details = [...document.querySelectorAll('.nav details')];
      for (const d of details) {
        d.addEventListener('toggle', () => {
          if ((d as HTMLDetailsElement).open)
            for (const o of details) if (o !== d) (o as HTMLDetailsElement).open = false;
        });
      }
      document.addEventListener('click', (ev) => {
        if (!(ev.target as Element).closest('.nav'))
          for (const o of details) (o as HTMLDetailsElement).open = false;
      });
    </script>
    <script is:inline define:vars={{ base }}>
      // Header search: lazy-fetched flat index, 3-tier ranking (starts-with >
      // word-boundary > substring), keyboard nav. owreference lineage.
      const input = document.getElementById('global-search');
      const box = document.getElementById('search-results');
      let index = null, sel = -1, shown = [];
      async function load() {
        if (!index) {
          try { index = await (await fetch(`${base}/data/search-index.json`)).json(); }
          catch { index = []; }
        }
      }
      function render() {
        if (!shown.length) { box.hidden = true; return; }
        box.innerHTML = shown.map((r, i) =>
          `<a class="sr${i === sel ? ' is-sel' : ''}" href="${base}${r.u}">` +
          (r.c ? `<img src="${base}${r.c}" alt="" width="18" height="18" loading="lazy">` : '<span class="sr__spacer"></span>') +
          `<span class="sr__n">${r.n}</span><span class="sr__t">${r.t}</span></a>`).join('');
        box.hidden = false;
      }
      function search(q) {
        q = q.trim().toLowerCase();
        if (!q) { shown = []; render(); return; }
        const starts = [], words = [], subs = [];
        for (const r of index) {
          const n = r.n.toLowerCase();
          if (n.startsWith(q)) starts.push(r);
          else if (n.includes(' ' + q)) words.push(r);
          else if (n.includes(q)) subs.push(r);
          if (starts.length > 40) break;
        }
        const byLen = (a, b) => a.n.length - b.n.length;
        shown = [...starts.sort(byLen), ...words.sort(byLen), ...subs.sort(byLen)].slice(0, 10);
        sel = -1;
        render();
      }
      input.addEventListener('focus', load);
      input.addEventListener('input', async () => { await load(); search(input.value); });
      input.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') { sel = Math.min(sel + 1, shown.length - 1); render(); e.preventDefault(); }
        else if (e.key === 'ArrowUp') { sel = Math.max(sel - 1, -1); render(); e.preventDefault(); }
        else if (e.key === 'Enter' && sel >= 0) { location.href = base + shown[sel].u; }
        else if (e.key === 'Escape') { box.hidden = true; input.blur(); }
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === '/' && !/INPUT|TEXTAREA|SELECT/.test(document.activeElement?.tagName ?? ''))
          { input.focus(); e.preventDefault(); }
      });
      document.addEventListener('click', (e) => {
        if (!e.target.closest('.search')) box.hidden = true;
      });
    </script>
  </body>
</html>
